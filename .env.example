PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ServiceTitan
SERVICETITAN_ENV=integration
SERVICETITAN_CAMPAIGN_ID=your-campaign-id
# Optional: last-resort fallback technician when match-technicians returns no rows
# SERVICETITAN_FALLBACK_TECHNICIAN_ID=14721

# BuildOps OAuth credentials (used by sync Edge Function)
CLIENT_ID=your-buildops-client-id
CLIENT_SECRET=your-buildops-client-secret
TENANT_ID=your-buildops-tenant-uuid

# BuildOps API base URL (optional — defaults to https://public-api.live.buildops.com)
# BUILDOPS_API_URL=https://public-api.live.buildops.com

# Retell
RETELL_API_KEY=your-retell-api-key
BASE_URL=https://crm-appointment-scheduler.vercel.app
LLM_ID=your-llm-id
